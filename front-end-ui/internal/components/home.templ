package components

import "github.com/pinas/ui/internal/components/setup"
import "github.com/pinas/ui/internal/structs"

templ Home (data structs.WizardInfo) {
    <!DOCTYPE html>
    <html lang="es" class="dark">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title>Pi NAS</title>
            <link href="/static/css/style.css" rel="stylesheet">
            <link href="/static/css/pico/pico.min.css" rel="stylesheet">

            <!-- Datastar v1: a single module script is the entire client runtime. -->
            <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.2/bundles/datastar.js"></script>

        </head>

       <body>

           <main id="app" >

               @setup.SetupWizardHeader()

               <div id="setup-wizard">
                    <div id="welcome-page" >
                        <!--- For now just go to the setup pi flow -->
                        @WelcomePage()
                    </div>

                   @setup.WizardButtons(data)

               </div>

           </main>

       </body>


     </html>
}