package setup

import "github.com/pinas/ui/internal/structs"

templ WizardButtons(data structs.WizardInfo) {

<div>

    <button id="nextButton"
            data-on:click="@post('/next')"
            class="mt-4 bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">Next</button>

    if data.Step > 0 {
    <button id="backButton"
            data-on:click="@post('/back')"
            class="mt-4 bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">Back</button>
    }
</div>


}