package setup

type WizardData struct {
    Step int
}


templ Setup(data WizardData) {

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Pi NAS</title>
    <link href="/static/css/style.css" rel="stylesheet">
    <link href="/static/css/pico/pico.min.css" rel="stylesheet">
    <script src="/static/js/htmx.js" defer></script>
</head>


<div id="wizard" class="wizard-container">
    if data.Step == 0 {
        @SystemInfoPage(data)
    } else if data.Step == 1 {
        @EnableNvmeFa(data)
    }
</div>

</html>
}