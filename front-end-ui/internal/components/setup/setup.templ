package setup

type WizardData struct {
    Step int
}


templ Setup(data WizardData) {

<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Pi NAS</title>
    <link href="/static/css/style.css" rel="stylesheet">
    <link href="/static/css/pico/pico.min.css" rel="stylesheet">
    <!-- Datastar v1: a single module script is the entire client runtime. -->
    <script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.2/bundles/datastar.js"></script>

</head>


<main id="app"
      data-signals="{step: 1, host: '', email: '', title: '', format: '', tagline: '', day: '', minutes: 45, commit: false, sending: false}">

    { children... }
</main>




</html>
}